#!/bin/bash

GREEN=$'\e[1;32m'
YELLOW=$'\e[1;33m'
RED=$'\e[1;31m'
BLUE=$'\e[1;34m'
END=$'\e[0m'

colorize(){
    echo "$1${END}" | sed "s/^/${RED}/ ; s/@/${END}@${YELLOW}/"
}

directory="$(dirname "$(realpath "$0")")"
source "$directory/resources/connections"

CLIP=0
PRINT_TARGET=0
case $1 in
    --clip | -c)
        CLIP=1
        ;;
    --print-target)
        PRINT_TARGET=1
        ;;
esac

# Show and search only host names and addresses; keep users for the next step.
choice=$(printf '%s\n' "$connections" | fzf --height 50% --prompt 'Host: ' --with-nth=1,2 --nth=1,2)
[ -z "$choice" ] && echo "nothing chosen, exiting..." >&2 && exit 1

read -r name host user_list <<< "$choice"
read -r -a users <<< "$user_list"
if [ -z "$host" ] || [ "${#users[@]}" -eq 0 ]; then
    echo "no target found, exiting..." >&2
    exit 1
fi

user=${users[0]}
if [ "${#users[@]}" -gt 1 ]; then
    user=$(printf '%s\n' "${users[@]}" | fzf --height 50% --prompt "User for $name: ")
    [ -z "$user" ] && echo "nothing chosen, exiting..." >&2 && exit 1
fi
target="$user@$host"

if [ "$PRINT_TARGET" -eq 1 ]; then
    printf '%s\n' "$target"
    exit
fi

colorized=$(colorize "$target")

if [ $CLIP -eq 1 ]; then
    echo -n "$target" | pbcopy
    echo "Copied to clipboard: $target"
    exit
fi

echo "${GREEN}running${END} ${BLUE}ssh${END} ${colorized}${END}"
ssh "$target"
